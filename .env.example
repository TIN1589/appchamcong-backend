# Environment Variables — appChamCong Backend
# Copy thành .env và điền giá trị thực

# ─── App ────────────────────────────────────────────────────────────────────
NODE_ENV=development
PORT=3000
TZ=UTC

# ─── Database ────────────────────────────────────────────────────────────────
POSTGRES_HOST=localhost
POSTGRES_PORT=5432
POSTGRES_DB=chamcong
POSTGRES_USER=chamcong_user
POSTGRES_PASSWORD=changeme_strong_password
# Hoặc dùng DATABASE_URL nếu kết nối Supabase / Neon
# DATABASE_URL=postgres://user:pass@host:5432/db

# ─── Redis ───────────────────────────────────────────────────────────────────
REDIS_URL=redis://localhost:6379

# ─── JWT ─────────────────────────────────────────────────────────────────────
# Tạo secret: node -e "console.log(require('crypto').randomBytes(64).toString('hex'))"
JWT_ACCESS_SECRET=changeme_access_secret_64_chars_minimum_please_change_this_now
JWT_REFRESH_SECRET=changeme_refresh_secret_64_chars_minimum_please_change_this_now
JWT_ACCESS_EXPIRES_IN=15m
JWT_REFRESH_EXPIRES_IN=7d

# ─── CORS ────────────────────────────────────────────────────────────────────
CORS_ORIGIN=http://localhost:5173

# ─── WiFi Restriction [A3] ───────────────────────────────────────────────────
WIFI_RESTRICTION=false
ALLOWED_IPS=192.168.1.0/24

# ─── Store ───────────────────────────────────────────────────────────────────
DEFAULT_STORE_ID=1

# ─── Admin Seed ──────────────────────────────────────────────────────────────
SEED_ADMIN_EMAIL=admin@chamcong.local
SEED_ADMIN_PASSWORD=Admin@1234!
